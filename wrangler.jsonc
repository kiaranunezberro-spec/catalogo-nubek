{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "catalogo-nubek",
  "main": "src/index.js",
  "compatibility_date": "2026-07-21",
  "compatibility_flags": ["nodejs_compat"],
  "workers_dev": true,
  "preview_urls": true,
  "vars": {
    "ORIGIN_URL": "https://catalogo-nubek.kiaranunezberro.chatgpt.site"
  },
  "observability": {
    "enabled": true,
    "head_sampling_rate": 1
  }
}
